# Supabase Dashboard > Connect. Use a publishable (or legacy anon) key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after applying supabase/migrations/202610010001_catalog_and_accounts.sql
# and configuring Google provider + redirect URLs. Missing settings keep the empty UI.
KICKX_DATABASE_ENABLED=false

# Frontend development only: serve labeled sample data (players, assets, squad, posts) while no
# database is configured. Every screen shows an "예시 데이터" badge; writes stay local and unsaved.
# Ignored when the Supabase connection above is enabled. Keep false/unset in production.
KICKX_MOCK_DATA=false
