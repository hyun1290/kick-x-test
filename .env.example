# Supabase Dashboard > Connect. Use a publishable (or legacy anon) key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after applying supabase/migrations/202610010001_catalog_and_accounts.sql
# and configuring Google provider + redirect URLs. Missing settings keep the empty UI.
KICKX_DATABASE_ENABLED=false
